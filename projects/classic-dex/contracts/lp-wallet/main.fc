;; decompiled by @fiscaldev
const int MIN_STORAGE_RESERVE = 10000000;
const int GAS_RESERVE = 15000000;
const int OP_TRANSFER = 260734629;
const int OP_INTERNAL_TRANSFER = 395134233;
const int OP_BURN = 1499400124;
const int OP_TRANSFER_NOTIFICATION = 1935855772;
const int OP_BURN_NOTIFICATION = 2078119902;
const int OP_EXCESSES = 3576854235;
const int SEND_MODE_CARRY_REMAINING_MESSAGE_VALUE = 64;
const int SEND_MODE_PAY_FEES_SEPARATELY = 1;
const int SEND_MODE_IGNORE_ERRORS = 2;
#pragma version =0.4.4;
#include "../../../libraries/func/stdlib.fc";
() require_basechain(slice address) impure;
;; Evaluation barrier: emits no TVM instruction. The archived comparison evaluates
;; its constant before duplicating the opcode; ordinary equality changes that order.
int evaluate_opcode(int value) impure asm "nop";
;; MIN_STORAGE_RESERVE - min(balance_before_message, MIN_STORAGE_RESERVE).
;; Keep the historical literal/stack order; this is a typed arithmetic primitive.
int storage_gap(int balance) asm "10000000 PUSHINT 10000000 PUSHINT s1 s2 XCHG MIN SUB";
int is_basechain(int workchain) asm "0 PUSHINT EQUAL";
int double_gas_reserve(int amount) asm "1 LSHIFT#";
;; Preserve header-before-body evaluation in the outgoing transfer.
builder store_body_ref(builder header, cell body) asm "SWAP" "STREF";
;; Storage: LP amount, owner address, pool address, wallet code reference.
;; The archived implementation permits unused storage suffixes.
(int, slice, slice, cell) load_wallet_data() inline {
    slice data = get_data().begin_parse();
    int balance = data~load_grams();
    slice owner = data~load_msg_addr();
    slice pool = data~load_msg_addr();
    cell code = data~load_ref();
    return (balance, owner, pool, code);
}

cell pack_wallet_data(int balance, slice owner, slice pool, cell code) inline {
    return begin_cell().store_grams(balance).store_slice(owner).store_slice(pool)
        .store_ref(code).end_cell();
}

cell wallet_state_init(slice owner, slice pool, cell code) inline {
    return begin_cell().store_uint(0, 2).store_maybe_ref(code).store_maybe_ref(pack_wallet_data(0,
        owner, pool, code)).store_uint(0, 1).end_cell();
}

() handle_bounce(slice body) impure;
() handle_transfer(slice body, slice sender, int message_value, int forward_fee) impure;
() handle_internal_transfer(slice body, slice sender, int contract_ton_balance, int forward_fee,
    int message_value) impure;
(int, slice, slice, cell) get_wallet_data() impure;
() handle_burn(slice body, slice sender, int message_value, int forward_fee) impure;
() recv_internal(int contract_ton_balance, int message_value, cell full_message, slice body) impure method_id(0) {
    if (body.slice_empty?()) {
        return ();
    }
    slice header = full_message.begin_parse();
    int flags = header~load_uint(4);
    if (flags & 1) {
        handle_bounce(body);
        return ();
    }
    slice sender = header~load_msg_addr();
    header~load_msg_addr();
    header~load_grams();
    slice fee_header = header.skip_bits(1);
    fee_header~load_grams();
    int encoded_forward_fee = fee_header~load_grams();
    int forward_fee = muldiv(encoded_forward_fee, 3, 2);
    int opcode = body~load_uint(32);
    if ((opcode == evaluate_opcode(OP_TRANSFER))) {
        handle_transfer(body, sender, message_value, forward_fee);
        return ();
    }
    if ((opcode == evaluate_opcode(OP_INTERNAL_TRANSFER))) {
        handle_internal_transfer(body, sender, contract_ton_balance, forward_fee, message_value);
        return ();
    }
    if ((opcode == evaluate_opcode(OP_BURN))) {
        handle_burn(body, sender, message_value, forward_fee);
        return ();
    }
    throw(65535);
}

;; The 32-bit bounce prefix is skipped without validating its contents.
() handle_bounce(slice body) impure method_id(11) {
    slice bounced_body = body.skip_bits(32);
    (int wallet_balance, slice owner, slice pool, cell wallet_code) = load_wallet_data();
    int opcode = bounced_body~load_uint(32);
    throw_unless(709, (((opcode == evaluate_opcode(OP_INTERNAL_TRANSFER))) | ((opcode == evaluate_opcode(OP_BURN_NOTIFICATION)))));
    bounced_body~load_uint(64);
    int amount = bounced_body~load_grams();
    set_data(pack_wallet_data((wallet_balance + amount), owner, pool, wallet_code));
    return ();
}

() require_basechain(slice address) impure {
    (int workchain, _) = address.parse_std_addr();
    throw_unless(333, (is_basechain(workchain)));
    return ();
}

() handle_transfer(slice body, slice sender, int message_value, int forward_fee) impure method_id(8) {
    int query_id = body~load_uint(64);
    int amount = body~load_grams();
    slice recipient_owner = body~load_msg_addr();
    require_basechain(recipient_owner);
    (int wallet_balance, slice owner, slice pool, cell wallet_code) = load_wallet_data();
    int remaining_balance = (wallet_balance - amount);
    throw_unless(705, equal_slice_bits(owner, sender));
    throw_unless(706, (remaining_balance > -1));
    ;; Peer derivation happens before decoding custom/forward payloads.
    cell state_init = wallet_state_init(recipient_owner, pool, wallet_code);
    slice recipient_wallet = begin_cell().store_uint(4, 3).store_int(0, 8).store_uint(cell_hash(state_init),
        256).end_cell().begin_parse();
    slice response_address = body~load_msg_addr();
    body~load_dict();
    int forward_ton = body~load_grams();
    throw_unless(708, (body.slice_bits() > 0));
    ;; Assemble the message before the budget check, preserving error priority.
    builder outgoing = begin_cell().store_uint(24, 6).store_slice(recipient_wallet)
        .store_grams(0).store_uint(7, 108).store_ref(state_init).store_body_ref(begin_cell()
        .store_uint(OP_INTERNAL_TRANSFER, 32).store_uint(query_id, 64).store_grams(amount)
        .store_slice(owner).store_slice(response_address).store_grams(forward_ton).store_slice(body)
        .end_cell());
    int forward_message_count = 0;
    if (forward_ton) {
        forward_message_count = 2;
    } else {
        forward_message_count = 1;
    }
    throw_unless(709, (message_value > ((forward_ton + (forward_message_count * forward_fee)) + (double_gas_reserve(GAS_RESERVE) + MIN_STORAGE_RESERVE))));
    send_raw_message(outgoing.end_cell(), SEND_MODE_CARRY_REMAINING_MESSAGE_VALUE);
    set_data(pack_wallet_data(remaining_balance, owner, pool, wallet_code));
    return ();
}

() handle_internal_transfer(slice body, slice sender, int contract_ton_balance, int forward_fee,
    int message_value) impure method_id(9) {
    (int wallet_balance, slice owner, slice pool, cell wallet_code) = load_wallet_data();
    int query_id = body~load_uint(64);
    int amount = body~load_grams();
    ;; Credit before authentication; a throw rolls back the entire transaction.
    wallet_balance += amount;
    slice sender_owner = body~load_msg_addr();
    slice response_address = body~load_msg_addr();
    throw_unless(707, (equal_slice_bits(pool, sender) | equal_slice_bits(begin_cell()
        .store_uint(4, 3).store_int(0, 8).store_uint(cell_hash(wallet_state_init(sender_owner, pool,
        wallet_code)), 256).end_cell().begin_parse(), sender)));
    int forward_ton = body~load_grams();
    int balance_before_message = contract_ton_balance - message_value;
    int remaining_ton = (message_value - (storage_gap(balance_before_message) + GAS_RESERVE));
    if (forward_ton) {
        remaining_ton -= (forward_ton + forward_fee);
        send_raw_message(begin_cell().store_uint(16, 6).store_slice(owner).store_grams(forward_ton)
            .store_uint(1, 107).store_ref(begin_cell().store_uint(OP_TRANSFER_NOTIFICATION, 32)
            .store_uint(query_id, 64).store_grams(amount).store_slice(sender_owner)
            .store_slice(body).end_cell()).end_cell(), SEND_MODE_PAY_FEES_SEPARATELY);
    }
    if ((response_address.preload_uint(2) != 0) & (remaining_ton > 0)) {
        send_raw_message(begin_cell().store_uint(16, 6).store_slice(response_address)
            .store_grams(remaining_ton).store_uint(0, 107).store_uint(OP_EXCESSES, 32)
            .store_uint(query_id, 64).end_cell(), SEND_MODE_IGNORE_ERRORS);
    }
    set_data(pack_wallet_data(wallet_balance, owner, pool, wallet_code));
    return ();
}

(int, slice, slice, cell) get_wallet_data() impure method_id(97026) {
    (int wallet_balance, slice owner, slice pool, cell wallet_code) = load_wallet_data();
    return (wallet_balance, owner, pool, wallet_code);
}

() handle_burn(slice body, slice sender, int message_value, int forward_fee) impure method_id(10) {
    (int wallet_balance, slice owner, slice pool, cell wallet_code) = load_wallet_data();
    int query_id = body~load_uint(64);
    int amount = body~load_grams();
    slice response_address = body~load_msg_addr();
    int remaining_balance = (wallet_balance - amount);
    throw_unless(705, equal_slice_bits(owner, sender));
    throw_unless(706, (remaining_balance > -1));
    throw_unless(707, (message_value > (forward_fee + double_gas_reserve(GAS_RESERVE))));
    send_raw_message(begin_cell().store_uint(24, 6).store_slice(pool).store_grams(0)
        .store_uint(1, 107).store_ref(begin_cell().store_uint(OP_BURN_NOTIFICATION, 32)
        .store_uint(query_id, 64).store_grams(amount).store_slice(owner).store_slice(response_address)
        .end_cell()).end_cell(), SEND_MODE_CARRY_REMAINING_MESSAGE_VALUE);
    set_data(pack_wallet_data(remaining_balance, owner, pool, wallet_code));
    return ();
}
