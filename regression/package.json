{
  "name": "tvm-decompiler-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible checks for TVM to FunC/Tolk decompilation",
  "scripts": {
    "check": "node scripts/check.mjs",
    "corpus": "node scripts/corpus.mjs",
    "test": "node --test tests/*.test.mjs",
    "acton": "node scripts/check-acton.mjs",
    "report": "node scripts/export-html.mjs",
    "verify": "node scripts/corpus.mjs --local --native --strict",
    "verify:tolk": "node scripts/corpus.mjs --local --native --language tolk --strict",
    "tolk:edges": "node scripts/check-tolk-edges.mjs",
    "tolk:normalization": "node scripts/check-tolk-normalization.mjs",
    "tolk:patterns": "node scripts/catalog-tolk-patterns.mjs"
  },
  "dependencies": {
    "@ton-community/func-js": "0.11.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.45.0"
  }
}
