{
  "name": "tvm-decompiler-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible checks for TVM to FunC/Tolk decompilation",
  "scripts": {
    "check": "node scripts/check.mjs",
    "corpus": "node scripts/corpus.mjs",
    "test": "node --test tests/*.test.mjs",
    "acton": "node scripts/check-acton.mjs",
    "report": "node scripts/export-html.mjs",
    "verify": "node scripts/corpus.mjs --local --native --strict",
    "verify:tolk": "node scripts/corpus.mjs --local --native --language tolk --strict",
    "tolk:edges": "node scripts/check-tolk-edges.mjs",
    "tolk:normalization": "node scripts/check-tolk-normalization.mjs",
    "tolk:matches": "node scripts/check-tolk-matches.mjs",
    "tolk:recovery": "node scripts/check-tolk-recovery.mjs",
    "tolk:builders": "node scripts/check-tolk-builders.mjs",
    "tolk:nullable": "node scripts/check-tolk-nullable.mjs",
    "tolk:loops": "node scripts/check-tolk-loops.mjs",
    "tolk:again": "node scripts/check-tolk-again.mjs",
    "tolk:exceptions": "node scripts/check-tolk-exceptions.mjs",
    "tolk:dispatch": "node scripts/check-tolk-dispatch.mjs",
    "tolk:messages": "node scripts/check-tolk-messages.mjs",
    "tolk:arithmetic": "node scripts/check-tolk-arithmetic.mjs",
    "tolk:catalog": "node scripts/check-tolk-catalog.mjs",
    "tolk:dictionary": "node scripts/check-tolk-dictionary.mjs",
    "dispatch:ambiguity": "node scripts/check-dispatch-ambiguity.mjs",
    "schema:ambiguity": "node scripts/check-schema-ambiguity.mjs",
    "tolk:audit": "node scripts/audit-recovery-results.mjs",
    "tolk:patterns": "node scripts/catalog-tolk-patterns.mjs"
  },
  "dependencies": {
    "@ton-community/func-js": "0.11.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.45.0"
  }
}
